<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- 1. 核心代理开关 -->
    <LinearLayout
        android:id="@+id/btn_toggle_vpn"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/bg_wear_pill_disconnected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已断开"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="点击启动代理"
            android:textColor="#A0A0A5"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2. 当前节点选择卡片 -->
    <LinearLayout
        android:id="@+id/btn_select_node"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_wear_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_current_node"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="选择节点"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#666666"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. 底部操作区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_ping_test"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wear_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚡ 测延迟"
            android:textColor="#0A84FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_open_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wear_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙️ 设置"
            android:textColor="#8E8E93"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>